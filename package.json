{
  "name": "keyworth",
  "version": "0.0.0",
  "private": true,
  "description": "Private AI portfolio assistant with end-to-end encryption",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "sideEffects": [
    "*.css",
    "./src/main.tsx",
    "./src/vault/index.ts",
    "./shared/schemas/zod.ts"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "wrangler dev --config dist/keyworth/wrangler.json --port 4173 --local-upstream localhost:4173",
    "build:design": "vite build --mode design",
    "preview:design": "wrangler dev --config dist-design/keyworth/wrangler.json --port 4174 --local-upstream localhost:4174",
    "typecheck": "tsc -b",
    "cf:types": "wrangler types",
    "deploy": "npm run build && wrangler deploy",
    "lint": "NODE_OPTIONS=--max-old-space-size=4096 eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "licenses": "node scripts/check-licenses.ts",
    "docs:check": "node scripts/check-docs.ts",
    "mutate": "node scripts/mutate.ts",
    "bundle:size": "node scripts/bundle-size.ts",
    "cf:types:check": "wrangler types --check",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run cf:types:check && npm test && npm run licenses && npm run docs:check && npm run build",
    "test:e2e": "playwright test",
    "test:visual": "node scripts/visual.ts",
    "test:visual:update": "node scripts/visual.ts --update-snapshots",
    "hooks:install": "lefthook install",
    "design:screenshots": "playwright test -c design/capture/playwright.config.ts --project=screenshots",
    "design:videos": "playwright test -c design/capture/playwright.config.ts --project=videos",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:auth-schema": "node scripts/generate-auth-schema.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "users": "node scripts/users.ts"
  },
  "dependencies": {
    "@fontsource-variable/onest": "5.3.1",
    "@internationalized/date": "3.12.4",
    "@noble/hashes": "2.4.0",
    "@tailwindcss/vite": "4.3.4",
    "@tanstack/react-query": "5.105.3",
    "@tanstack/react-router": "1.170.46",
    "animejs": "4.5.0",
    "better-auth": "1.7.16",
    "big.js": "7.0.1",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.16",
    "lucide-react": "1.68.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/vite-plugin": "1.67.0",
    "@cloudflare/vitest-plugin": "1.6.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@react-aria/optimize-locales-plugin": "2.1.0",
    "@types/big.js": "7.0.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "drizzle-kit": "0.31.11",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "lefthook": "2.2.2",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0",
    "wrangler": "4.158.0"
  }
}
