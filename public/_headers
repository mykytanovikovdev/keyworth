# Security headers for static assets and the SPA shell (index.html).
# The Worker never runs for these responses; Worker responses get their headers
# from worker/security-headers.ts. Exact values are asserted by tests/e2e.
# Limits: 100 rules, 2000 characters per line.
#
# The two style-src hashes allow exactly two fixed <style> blocks that React Aria
# inserts at runtime (touch-action for pressable elements; overscroll-behavior
# while a dialog is open on iOS). A hash matches only that exact text, so no other
# inline style is allowed. If React Aria changes the text, the e2e tests report a
# CSP violation and Chromium's console prints the new hash. See worker/README.md.
#
# no-transform keeps Cloudflare's zone features (the Web Analytics beacon, email
# obfuscation, Rocket Loader) from rewriting pages at the edge: the page that
# will hold encryption keys reaches the browser exactly as it was built. The CSP
# would block an injected script anyway; this keeps it out of the page entirely.

/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self' 'sha256-38RhXrc7EdReTKsOm23ZPOCUgniTUUcjky8QOOrQx6o=' 'sha256-gYiS/BvZvRcK27JIXTuwhZ3hs2+VJ1X+2gUlE+farlg='; img-src 'self'; font-src 'self'; connect-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; require-trusted-types-for 'script'; trusted-types 'none'
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  Referrer-Policy: same-origin
  Permissions-Policy: accelerometer=(), autoplay=(), bluetooth=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), hid=(), magnetometer=(), microphone=(), midi=(), payment=(), serial=(), usb=(), publickey-credentials-create=(self), publickey-credentials-get=(self)
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Resource-Policy: same-origin
  X-Frame-Options: DENY
  X-Robots-Tag: noindex, nofollow
  Cache-Control: public, max-age=0, must-revalidate, no-transform

# Hashed build output never changes under the same URL. The rule above is
# detached first: two Cache-Control values would be joined into one header.
/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable, no-transform
