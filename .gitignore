# Markdown: README files and docs/*.md are tracked; everything else (CLAUDE.md,
# PLAN.md, HANDOFF.md, notes) is a local working doc
*.md
!README.md
!**/README.md
!**/docs/*.md

# Secrets
.dev.vars
.dev.vars.*
!.dev.vars.example
.env
.env.*

# Dependencies and build output
node_modules/
dist/
dist-design/
.wrangler/
*.tsbuildinfo

# Test output
coverage/
test-results/
playwright-report/
blob-report/

# Design working screenshots (baselines for visual tests live under tests/)
design/screenshots/

# OS and editors
.DS_Store
*.log
.vscode/
.idea/
