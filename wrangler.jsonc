{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "keyworth",
  "main": "./worker/index.ts",
  // Must not be newer than the workerd version bundled with wrangler.
  "compatibility_date": "2026-10-12",
  "assets": {
    // Unknown paths serve index.html so client-side routes work on reload.
    "not_found_handling": "single-page-application",
    // Browser navigations to unknown paths would otherwise get index.html without
    // invoking the Worker — that breaks OAuth callbacks under /api/auth/*.
    "run_worker_first": ["/api/*"],
  },
  // The production address. Cloudflare creates the DNS record and the
  // certificate for it on deploy; the zone is in this account.
  "routes": [{ "pattern": "keyworth.app", "custom_domain": true }],
  // Kept on while keyworth.app is being verified; turned off when sign-in goes
  // live, so the app has a single origin (cookies, OAuth redirect URI, CSP).
  "workers_dev": true,
  // Per-version preview URLs are public; we don't use them.
  "preview_urls": false,
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      // Keep only what our code logs explicitly; no automatic per-request records.
      "invocation_logs": false,
    },
  },
}
