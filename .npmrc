# Supply-chain hardening. See the "Dependencies" section of the root README.
# Pin exact versions so every change goes through the lockfile and review.
save-exact=true
# Never run install scripts of dependencies (the main npm worm vector).
# Explicitly invoked scripts (`npm run x`) still work.
ignore-scripts=true
# Refuse to install with an unsupported Node version.
engine-strict=true
fund=false
